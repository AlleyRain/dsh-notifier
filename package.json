{
  "name": "@local/dsh-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser system notifications for DSH approvals and user questions",
  "author": "AlleyRain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlleyRain/dsh-notifier.git"
  },
  "homepage": "https://github.com/AlleyRain/dsh-notifier#readme",
  "bugs": {
    "url": "https://github.com/AlleyRain/dsh-notifier/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "notifications",
    "plugin",
    "approval",
    "ask-user-question"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
